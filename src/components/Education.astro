---
import EducationItem from './EducationItem.astro'
import { CV_EDUCATION } from '../data/education';

const EXTRA_EDUCATION = [
    {
        date: 'September 2021 - March 2022',
        dateI18n: 'edu.date.2',
        title: 'Universidad de Sevilla',
        titleI18n: 'edu.title.2',
        description: [
            "Bachelor's Degree in Telecommunication Technologies and Services Engineering"
        ],
        descriptionI18n: ['edu.2.desc.0'],
    },
    {
        date: 'September 2019 - July 2020',
        dateI18n: 'edu.date.3',
        title: 'Università degli Studi di Cagliari',
        titleI18n: 'edu.title.3',
        description: [
            "Bachelor's Degree in Telecommunication Technologies and Services Engineering"
        ],
        descriptionI18n: ['edu.3.desc.0'],
    },
    {
        date: 'September 2018 - June 2023',
        dateI18n: 'edu.date.4',
        title: 'Conservatorio Profesional de Música y Danza de Gijón',
        titleI18n: 'edu.title.4',
        description: [
            "Guitar Specialty"
        ],
        descriptionI18n: ['edu.4.desc.0'],
    },
]

const EDUCATION = [...CV_EDUCATION, ...EXTRA_EDUCATION];

---
<ol class="relative border-s border-blue-300 mx-5 my-5">
    {EDUCATION.map((item) => (
        <li class="mb-10 ms-4">
            <EducationItem {...item} />
        </li>
    ))}    
</ol>
