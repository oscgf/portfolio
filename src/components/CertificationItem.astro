---
interface Props {
	title: string;
    description: string[];
    date: string;
    dateI18n?: string;
    titleI18n?: string;
    descriptionI18n?: string[];
    linkLabel?: string;
    linkLabelI18n?: string;
    url?: string;
}

const { title, description, date, dateI18n, titleI18n, descriptionI18n, linkLabel, linkLabelI18n, url } = Astro.props;
---

<div class="absolute w-3 h-3 bg-blue-400 rounded-full mt-1.5 -start-1.5 border border-white"></div>
<time class="mb-1 text-xs sm:text-sm font-normal leading-none text-blue-400 italic">
    {dateI18n ? <span data-i18n={dateI18n}>{date}</span> : date}
</time>
<h3 class="sm:text-lg font-semibold text-gray-800 py-1">
    {titleI18n ? <span data-i18n={titleI18n}>{title}</span> : title}
</h3>
    {description.map((text, i) => (
        <p class="py-1 text-sm sm:text-base font-normal text-gray-500">
            {descriptionI18n?.[i] ? <span data-i18n={descriptionI18n[i]}>{text}</span> : text}
        </p>
    ))}
    {url && (
        <a href={url} target="_blank" rel="noopener noreferrer"
           class="mt-1 inline-flex items-center gap-1 text-sm font-medium text-blue-700 hover:text-blue-900 hover:underline">
            {linkLabelI18n ? <span data-i18n={linkLabelI18n}>{linkLabel}</span> : linkLabel}
            <svg class="w-3.5 h-3.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18v4.5M18 6l-7 7M9 6H6a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-3"/>
            </svg>
        </a>
    )}
