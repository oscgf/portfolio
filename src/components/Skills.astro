---
import { TECHNICAL_SKILLS, LANGUAGE_SKILLS } from '../data/skills';

const className = "bg-white p-6 mb-8 rounded-lg shadow-lg transition-transform transform hover:scale-105 duration-200"; 
---

<section class="">

    <!-- Technical Skills -->
    <div class={className}>
        <h3 class="text-xl md:text-2xl font-semibold text-gray-900" data-i18n="skills.technical">Technical</h3>
        <div class="overflow-x-auto mt-2">
            <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow-lg">
                <thead>
                    <tr class="bg-gray-100 text-gray-900">
                        <th class="py-2 px-4 border-b text-left" data-i18n="skills.category">Category</th>
                        <th class="py-2 px-4 border-b text-left" data-i18n="skills.skill">Skill</th>
                    </tr>
                </thead>
                <tbody>
                    {TECHNICAL_SKILLS.map(skill => (
                        <tr class="hover:bg-gray-50 transition duration-200">
                            <td class="py-2 px-4 border-b text-gray-700">
                                <span class="font-medium" data-i18n={skill.i18n}>{skill.category}</span>
                            </td>
                            <td class="py-2 px-4 border-b text-gray-500">
                                {skill.names.join(', ')}
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Language Skills -->
    <div class={className}>
        <h3 class="text-xl md:text-2xl font-semibold text-gray-900" data-i18n="skills.languages">Languages</h3>
        <div class="flex flex-col items-center sm:flex-row mt-2">
            {LANGUAGE_SKILLS.map(lang => (
                <div class="flex flex-col items-center p-2 w-full border-b sm:border-none">
                    <span class="text-lg md:text-xl font-bold text-blue-500 mb-1">{lang.name}</span>
                    <span class="font-medium text-gray-700" data-i18n={lang.levelI18n}>{lang.level}</span>
                    <span class="text-gray-500">{lang.certificate}</span>

                </div>
            ))}
        </div>
    </div>
    
  </section>
  
