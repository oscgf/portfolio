---
interface Props {
	title: string;
    description: string[];
    date: string;
    dateI18n?: string;
    titleI18n?: string;
    descriptionI18n?: string[];
}

const { title, description, date, dateI18n, titleI18n, descriptionI18n } = Astro.props;
---

<div class="absolute w-3 h-3 bg-blue-400 rounded-full mt-1.5 -start-1.5 border border-white"></div>
<time class="mb-1 text-xs sm:text-sm font-normal leading-none text-blue-400 italic">
    {dateI18n ? <span data-i18n={dateI18n}>{date}</span> : date}
</time>
<h3 class="sm:text-lg font-semibold text-gray-800 py-1">
    {titleI18n ? <span data-i18n={titleI18n}>{title}</span> : title}
</h3>
    {description.map((text, i) => (
        <p class="py-1 text-sm sm:text-base font-normal text-gray-500">
            · {descriptionI18n?.[i] ? <span data-i18n={descriptionI18n[i]}>{text}</span> : text}
        </p>
    ))}
