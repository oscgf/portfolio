---
import ExperienceItem from './ExperienceItem.astro'
import { EXPERIENCE } from '../data/experience'

const maxItems = 2
const showAll = EXPERIENCE.length > maxItems
const items = EXPERIENCE.slice(0, maxItems)
---
<ol class="relative border-s border-blue-300 mx-5 my-5">
    {items.map((item) => (
        <li class="mb-10 ms-4">
            <ExperienceItem {...item} />
        </li>
    ))}
</ol>

{showAll && (
    <a href="/portfolio/experience" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center mx-5">
    More experience
        <svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
        </svg>
    </a>
)}

